# ---------------------------------------------------------------------------
# AI Kripto Bot ayarları — bu dosyayı ".env" adıyla kopyalayıp düzenleyin.
# Uygulama içi ayarlar (semboller, risk, stop/hedef...) arayüzdeki Ayarlar
# sayfasından yapılır; burada yalnızca gizli anahtarlar ve sistem ayarları var.
# ---------------------------------------------------------------------------

# Borsa (ccxt kimliği): binance, bybit, okx, kucoin, gateio, btcturk ...
EXCHANGE=binance

# Borsa API anahtarları — yalnızca CANLI işlem için gerekir. Piyasa verisi
# anahtarsız çalışır. Anahtarı oluştururken SADECE "Spot işlem" iznini verin,
# "Para çekme" iznini KESİNLİKLE kapalı tutun ve mümkünse IP kısıtlaması koyun.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Bazı borsalar (OKX, KuCoin) ek parola ister:
EXCHANGE_API_PASSWORD=

# Gerçek parayla işlem için bilinçli olarak "true" yapın. Varsayılan: kapalı.
ENABLE_LIVE_TRADING=false

# Veri kaynağı: auto (borsa, erişilemezse simülasyon) | exchange | demo
DATA_SOURCE=auto

# İsteğe bağlı: Claude ile AI Analist yorumları (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Paneli ağa açarsanız mutlaka bir erişim anahtarı belirleyin.
DASHBOARD_TOKEN=

# Sunucu
HOST=127.0.0.1
PORT=8000
# DATA_DIR=./backend/data
